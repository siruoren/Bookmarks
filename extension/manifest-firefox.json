{
  "manifest_version": 3,
  "name": "Bookmarks New Tab",
  "version": "1.0.0",
  "description": "自定义新标签页 - 从后端服务获取书签导航",
  "browser_specific_settings": {
    "gecko": {
      "id": "bookmarks-new-tab@example.com",
      "strict_min_version": "110.0"
    }
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "background": {
    "scripts": ["background.js"]
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
