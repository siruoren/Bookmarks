{
  "manifest_version": 2,
  "name": "SeaTab",
  "version": "1.0.0",
  "description": "自定义新标签页 - 从后端服务获取书签导航",
  "browser_specific_settings": {
    "gecko": {
      "id": "zhuguojun6@163.com",
      "strict_min_version": "60.0"
    }
  },
  "data_collection_permissions": {
    "marketing_data": false,
    "health_report": false,
    "telemetry": false
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "background": {
    "scripts": ["background.js", "background-firefox.js"]
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "permissions": [
    "storage",
    "alarms",
    "tabs",
    "bookmarks",
    "<all_urls>"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
