{
  "manifest_version": 2,
  "name": "SeeTab",
  "version": "1.2.1",
  "description": "自定义新标签页 - 从后端服务获取书签导航",
  "browser_specific_settings": {
    "gecko": {
      "id": "dp8y1l87zlxq@seetab.app",
      "strict_min_version": "60.0",
      "data_collection_permissions": {
        "required": ["bookmarksInfo"],
        "optional": []
      }
    }
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "background": {
    "scripts": ["background.js", "background-firefox.js"]
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "permissions": [
    "storage",
    "alarms",
    "tabs",
    "bookmarks",
    "<all_urls>"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
